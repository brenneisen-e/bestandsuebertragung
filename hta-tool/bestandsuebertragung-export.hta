<html>
<head>
    <title>Bestandsübertragung - Outlook Export</title>
    <HTA:APPLICATION
        ID="BestandsuebertragungExport"
        APPLICATIONNAME="Bestandsübertragung Export"
        BORDER="dialog"
        BORDERSTYLE="normal"
        CAPTION="yes"
        CONTEXTMENU="yes"
        ICON=""
        INNERBORDER="yes"
        MAXIMIZEBUTTON="no"
        MINIMIZEBUTTON="yes"
        NAVIGABLE="no"
        SCROLL="no"
        SCROLLFLAT="no"
        SELECTION="no"
        SHOWINTASKBAR="yes"
        SINGLEINSTANCE="yes"
        SYSMENU="yes"
        VERSION="1.0"
        WINDOWSTATE="normal"
    />
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta charset="UTF-8">
    <link rel="stylesheet" href="css/main.css">
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="header">
            <div class="logo">
                <svg width="32" height="32" viewBox="0 0 40 40" fill="none">
                    <rect width="40" height="40" rx="8" fill="#C8102E"/>
                    <text x="20" y="26" text-anchor="middle" fill="white" font-size="14" font-weight="bold">BÜ</text>
                </svg>
            </div>
            <h1>Bestandsübertragung Export</h1>
        </header>

        <!-- Status-Bereich -->
        <div class="status-bar" id="statusBar">
            <span class="status-icon">○</span>
            <span class="status-text" id="statusText">Bereit</span>
        </div>

        <!-- Hauptbereich -->
        <main class="main-content">
            <!-- Postfach-Auswahl -->
            <section class="section">
                <h2>1. Postfach auswählen</h2>
                <div class="form-group">
                    <label for="mailboxSelect">Outlook Postfach:</label>
                    <select id="mailboxSelect" disabled>
                        <option value="">-- Outlook verbinden --</option>
                    </select>
                    <button class="btn btn-primary" id="connectBtn" onclick="connectOutlook()">
                        Outlook verbinden
                    </button>
                </div>
            </section>

            <!-- Zeitraum-Filter -->
            <section class="section">
                <h2>2. Zeitraum festlegen</h2>
                <div class="form-row">
                    <div class="form-group">
                        <label for="dateFrom">Von:</label>
                        <input type="date" id="dateFrom">
                    </div>
                    <div class="form-group">
                        <label for="dateTo">Bis:</label>
                        <input type="date" id="dateTo">
                    </div>
                </div>
                <div class="quick-select">
                    <button class="btn btn-sm" onclick="setDateRange(7)">Letzte 7 Tage</button>
                    <button class="btn btn-sm" onclick="setDateRange(14)">Letzte 14 Tage</button>
                    <button class="btn btn-sm" onclick="setDateRange(30)">Letzte 30 Tage</button>
                    <button class="btn btn-sm" onclick="setDateRange(90)">Letzte 90 Tage</button>
                </div>
            </section>

            <!-- Ordner-Auswahl -->
            <section class="section">
                <h2>3. Ordner auswählen</h2>
                <div class="checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="folderInbox" checked>
                        <span>Posteingang</span>
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" id="folderSent" checked>
                        <span>Gesendete Elemente</span>
                    </label>
                </div>
            </section>

            <!-- Schlagwort-Filter -->
            <section class="section">
                <h2>4. Schlagwort-Filter (optional)</h2>
                <div class="form-group">
                    <label for="keywords">Suchbegriffe (einer pro Zeile):</label>
                    <textarea id="keywords" rows="4" placeholder="bestandsübertragung
maklervollmacht
courtagezusage
übertragung"></textarea>
                </div>
                <div class="checkbox-group">
                    <label class="checkbox-label">
                        <input type="checkbox" id="useKeywords">
                        <span>Nur E-Mails mit Schlagwörtern exportieren</span>
                    </label>
                </div>
            </section>

            <!-- Export-Optionen -->
            <section class="section">
                <h2>5. Export durchführen</h2>
                <div class="export-info" id="exportInfo">
                    <p>Gefundene E-Mails: <strong id="emailCount">-</strong></p>
                    <p>Konversationen: <strong id="convCount">-</strong></p>
                </div>
                <div class="button-group">
                    <button class="btn btn-secondary" id="scanBtn" onclick="scanEmails()" disabled>
                        E-Mails scannen
                    </button>
                    <button class="btn btn-primary" id="exportBtn" onclick="exportToJson()" disabled>
                        Als JSON exportieren
                    </button>
                </div>
            </section>

            <!-- Demo-Modus -->
            <section class="section demo-section">
                <h2>Demo-Modus</h2>
                <p class="hint">Ohne Outlook-Verbindung testen:</p>
                <button class="btn btn-outline" onclick="exportDemoData()">
                    Demo-Export erstellen
                </button>
            </section>
        </main>

        <!-- Fortschrittsanzeige -->
        <div class="progress-overlay" id="progressOverlay" style="display: none;">
            <div class="progress-box">
                <div class="progress-spinner"></div>
                <p id="progressText">Verarbeite...</p>
                <div class="progress-bar">
                    <div class="progress-fill" id="progressFill" style="width: 0%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="js/config.js"></script>
    <script src="js/outlook-connect.js"></script>
    <script src="js/email-extract.js"></script>
    <script src="js/file-export.js"></script>

    <script type="text/javascript">
        // Initialisierung beim Start
        window.onload = function() {
            initApp();
        };

        // Anwendung initialisieren
        function initApp() {
            // Standard-Datum setzen (letzte 14 Tage)
            setDateRange(14);

            // Schlagwörter vorbelegen
            document.getElementById('keywords').value = 'bestandsübertragung\nmaklervollmacht\ncourtagezusage\nübertragung\ncourtage';

            updateStatus('Bereit - Bitte Outlook verbinden', 'ready');
        }

        // Outlook verbinden
        function connectOutlook() {
            updateStatus('Verbinde mit Outlook...', 'working');
            showProgress('Verbinde mit Outlook...');

            try {
                var result = OutlookConnect.connect();

                if (result.success) {
                    // Postfächer in Dropdown laden
                    var select = document.getElementById('mailboxSelect');
                    select.innerHTML = '';

                    for (var i = 0; i < result.mailboxes.length; i++) {
                        var opt = document.createElement('option');
                        opt.value = result.mailboxes[i].name;
                        opt.textContent = result.mailboxes[i].name;
                        select.appendChild(opt);
                    }

                    select.disabled = false;
                    document.getElementById('scanBtn').disabled = false;
                    document.getElementById('connectBtn').textContent = 'Verbunden';
                    document.getElementById('connectBtn').disabled = true;

                    updateStatus('Verbunden mit ' + result.mailboxes.length + ' Postfach(/-fächern)', 'success');
                } else {
                    updateStatus('Fehler: ' + result.error, 'error');
                }
            } catch (e) {
                updateStatus('Outlook-Fehler: ' + e.message, 'error');
            }

            hideProgress();
        }

        // E-Mails scannen
        function scanEmails() {
            var settings = getExportSettings();

            if (!settings.mailbox) {
                updateStatus('Bitte Postfach auswählen', 'error');
                return;
            }

            updateStatus('Scanne E-Mails...', 'working');
            showProgress('Scanne E-Mails...');

            try {
                var result = EmailExtract.scan(settings);

                document.getElementById('emailCount').textContent = result.totalEmails;
                document.getElementById('convCount').textContent = result.conversationCount;

                if (result.totalEmails > 0) {
                    document.getElementById('exportBtn').disabled = false;
                    updateStatus(result.totalEmails + ' E-Mails in ' + result.conversationCount + ' Konversationen gefunden', 'success');
                } else {
                    updateStatus('Keine E-Mails im gewählten Zeitraum gefunden', 'warning');
                }
            } catch (e) {
                updateStatus('Scan-Fehler: ' + e.message, 'error');
            }

            hideProgress();
        }

        // Als JSON exportieren
        function exportToJson() {
            var settings = getExportSettings();

            updateStatus('Exportiere...', 'working');
            showProgress('Exportiere E-Mails...');

            try {
                var result = FileExport.exportToJson(settings);

                if (result.success) {
                    updateStatus('Export erfolgreich: ' + result.filename, 'success');
                    alert('Export erfolgreich!\n\nDatei: ' + result.filename + '\n\nSie können diese Datei jetzt in der Web-App importieren.');
                } else {
                    updateStatus('Export fehlgeschlagen: ' + result.error, 'error');
                }
            } catch (e) {
                updateStatus('Export-Fehler: ' + e.message, 'error');
            }

            hideProgress();
        }

        // Demo-Export (ohne Outlook)
        function exportDemoData() {
            updateStatus('Erstelle Demo-Export...', 'working');
            showProgress('Erstelle Demo-Daten...');

            try {
                var result = FileExport.exportDemo();

                if (result.success) {
                    updateStatus('Demo-Export erstellt: ' + result.filename, 'success');
                    alert('Demo-Export erfolgreich!\n\nDatei: ' + result.filename + '\n\nSie können diese Datei jetzt in der Web-App importieren.');
                } else {
                    updateStatus('Demo-Export fehlgeschlagen', 'error');
                }
            } catch (e) {
                updateStatus('Fehler: ' + e.message, 'error');
            }

            hideProgress();
        }

        // Export-Einstellungen sammeln
        function getExportSettings() {
            var keywords = [];
            if (document.getElementById('useKeywords').checked) {
                var keywordText = document.getElementById('keywords').value;
                keywords = keywordText.split('\n').filter(function(k) {
                    return k.trim().length > 0;
                });
            }

            return {
                mailbox: document.getElementById('mailboxSelect').value,
                dateFrom: document.getElementById('dateFrom').value,
                dateTo: document.getElementById('dateTo').value,
                folders: {
                    inbox: document.getElementById('folderInbox').checked,
                    sent: document.getElementById('folderSent').checked
                },
                keywords: keywords,
                useKeywords: document.getElementById('useKeywords').checked
            };
        }

        // Zeitraum setzen
        function setDateRange(days) {
            var today = new Date();
            var from = new Date();
            from.setDate(today.getDate() - days);

            document.getElementById('dateTo').value = formatDate(today);
            document.getElementById('dateFrom').value = formatDate(from);
        }

        // Datum formatieren (YYYY-MM-DD)
        function formatDate(date) {
            var year = date.getFullYear();
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var day = String(date.getDate()).padStart(2, '0');
            return year + '-' + month + '-' + day;
        }

        // Status aktualisieren
        function updateStatus(message, type) {
            var statusBar = document.getElementById('statusBar');
            var statusText = document.getElementById('statusText');

            statusBar.className = 'status-bar status-' + type;
            statusText.textContent = message;
        }

        // Fortschrittsanzeige
        function showProgress(text) {
            document.getElementById('progressText').textContent = text;
            document.getElementById('progressOverlay').style.display = 'flex';
        }

        function hideProgress() {
            document.getElementById('progressOverlay').style.display = 'none';
        }

        function updateProgress(percent, text) {
            if (text) {
                document.getElementById('progressText').textContent = text;
            }
            document.getElementById('progressFill').style.width = percent + '%';
        }

        // String.padStart Polyfill für IE
        if (!String.prototype.padStart) {
            String.prototype.padStart = function(targetLength, padString) {
                targetLength = targetLength >> 0;
                padString = String(padString || ' ');
                if (this.length >= targetLength) {
                    return String(this);
                }
                targetLength = targetLength - this.length;
                if (targetLength > padString.length) {
                    padString += padString.repeat(targetLength / padString.length);
                }
                return padString.slice(0, targetLength) + String(this);
            };
        }

        // String.repeat Polyfill für IE
        if (!String.prototype.repeat) {
            String.prototype.repeat = function(count) {
                var str = '' + this;
                count = +count;
                if (count < 0 || count === Infinity) {
                    throw new RangeError('repeat count must be non-negative and less than infinity');
                }
                count = Math.floor(count);
                if (str.length === 0 || count === 0) {
                    return '';
                }
                var result = '';
                while (count > 0) {
                    if (count % 2 === 1) {
                        result += str;
                    }
                    count = Math.floor(count / 2);
                    str += str;
                }
                return result;
            };
        }
    </script>
</body>
</html>
